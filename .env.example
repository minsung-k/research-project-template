# Copy to .env and fill in real values. .env is gitignored.
# Better: put these in your shell rc or ~/.netrc, not in a project file.

# WANDB_API_KEY=...        # https://wandb.ai/authorize
# HF_TOKEN=...             # if using HuggingFace gated models
# Override default paths if needed:
# FOO_DATA_DIR=/scratch/$USER/data/foo
# FOO_RUNS_DIR=/scratch/$USER/runs/foo
