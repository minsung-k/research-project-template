#!/bin/bash
# slurm/sweep_array.sbatch — SLURM array job for parallel sweeps.
#
# This expects a sweep dir to have been pre-generated by scripts/sweep.py:
#   $SWEEP_DIR/configs/run_0000.yaml
#   $SWEEP_DIR/configs/run_0001.yaml
#   ...
#
# Submit with:
#   sbatch --export=SWEEP_DIR=/scratch/$USER/runs/foo/sweeps/<sweep_id>,ALL \
#          --array=0-23%8 slurm/sweep_array.sbatch
#
# %8 = max 8 concurrent. Tune to your queue manners.

#SBATCH --job-name=foo-sweep
#SBATCH --partition=gpu_p
#SBATCH --gres=gpu:A100:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64gb
#SBATCH --time=1-00:00:00
#SBATCH --output=/scratch/%u/runs/foo/_slurm/sweep-%A_%a.log
#SBATCH --error=/scratch/%u/runs/foo/_slurm/sweep-%A_%a.err

if [[ -z "$SWEEP_DIR" ]]; then
    echo "ERROR: SWEEP_DIR not set. Submit with --export=SWEEP_DIR=...,ALL"
    exit 1
fi

cd $SLURM_SUBMIT_DIR
source setup_env.sh

TASK_ID=$(printf "%04d" $SLURM_ARRAY_TASK_ID)
CFG_FILE="$SWEEP_DIR/configs/run_${TASK_ID}.yaml"

if [[ ! -f "$CFG_FILE" ]]; then
    echo "ERROR: config $CFG_FILE not found"
    exit 1
fi

echo "host:   $(hostname)"
echo "gpu:    $(nvidia-smi -L)"
echo "config: $CFG_FILE"

python scripts/train.py --config-path "$SWEEP_DIR/configs" --config-name "run_${TASK_ID}"
